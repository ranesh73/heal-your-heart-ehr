# Heal Your Heart EHR — AI Agent Configuration

# Option A: Groq Cloud API (Recommended: 24/7 High-Speed Cloud Inference, OpenAI-compatible)
# Sign up at https://console.groq.com/keys and obtain an API key (e.g. gsk_...)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=30.0

# Option B: Local Ollama (Self-hosted open weights)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=30.0

# Option C: Google Colab Remote GPU Host
# When running scripts/ollama_colab_host.ipynb on Google Colab,
# copy the generated Cloudflare tunnel URL below and uncomment it:
# OLLAMA_BASE_URL=https://your-generated-subdomain.trycloudflare.com

# Provider selection: "auto" (uses Groq if GROQ_API_KEY is set, else Ollama), "groq", or "ollama"
AI_PROVIDER=auto
